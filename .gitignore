# Files that Flutter, Xcode or FVM generate are never committed: they hold
# paths from the machine that made them and change on every build. Flutter
# recreates them on `flutter pub get` and `flutter run`. CI fails if one is
# committed (.github/workflows/ci.yml).

# Dart/Flutter
.dart_tool/
.packages
build/
coverage/
pubspec.lock

# FVM: the pinned Flutter version is in .fvmrc; .fvm/ only holds local links.
.fvm/

# IDE
.idea/
.vscode/
*.iml

# macOS
.DS_Store
*.swp

# Xcode
**/Pods/
**/xcuserdata/
**/DerivedData/

# iOS/Xcode
**/ios/.symlinks/
**/ios/Flutter/.last_build_id
**/ios/Flutter/ephemeral/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*

# macOS native
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/macos/Flutter/ephemeral/
.build/
.swiftpm/

# Example build artifacts
example/.dart_tool/
example/build/
example/.flutter-plugins
example/.flutter-plugins-dependencies
example/ios/Pods/
example/ios/.symlinks/
example/pubspec.lock

# Internal planning / design docs (kept local, never committed)
docs/superpowers/
